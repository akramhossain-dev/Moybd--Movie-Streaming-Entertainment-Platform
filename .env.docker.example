# ---------------------------------------------------
# Moybd Docker Environment Variables Example
# Copy to .env.docker and configure local/prod values
# ---------------------------------------------------

# Backend Settings
PORT=8080
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/moybd
SECRET_KEY=your_production_jwt_secret_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password_here
DOWNLOAD_ENCRYPTION_KEY=64_character_hex_encryption_key_here

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AES_SECRET=your_production_aes_secret_key_here
